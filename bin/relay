#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'smtp_relay'
require 'time'

$stdout.sync = true
logger = Logger.new($stdout, level: ENV.fetch('LOG_LEVEL', 'info'))
logger.formatter = proc { |sev, time, _prog, msg| "#{time.utc.iso8601} #{sev} #{msg}\n" }

server = SmtpRelay::Server.new(
  ses: SmtpRelay.ses_client(region: ENV.fetch('AWS_REGION', 'us-west-2')),
  allowed_cidrs: ENV.fetch('ALLOWED_CIDRS', '10.42.0.0/16').split(/[\s,]+/).reject(&:empty?),
  from_domain: ENV.fetch('ALLOWED_FROM_DOMAIN'),
  max_bytes: Integer(ENV.fetch('MAX_BYTES', 10 * 1024 * 1024)),
  max_recipients: Integer(ENV.fetch('MAX_RECIPIENTS', 50)),
  logger: logger,
  hosts: ENV.fetch('LISTEN_HOST', '0.0.0.0'),
  ports: ENV.fetch('LISTEN_PORT', '2525'),
  max_processings: Integer(ENV.fetch('MAX_PROCESSINGS', 16))
)
http = SmtpRelay::HTTP.new(server: server, port: Integer(ENV.fetch('METRICS_PORT', 9090)))

%w[TERM INT].each do |sig|
  Signal.trap(sig) { Thread.new { server.stop(wait_seconds_before_close: 5) } }
end

server.start
http.start
logger.info("listening smtp=#{server.ports.join(',')} http=#{http.port} from_domain=#{ENV['ALLOWED_FROM_DOMAIN']}")
server.join
http.stop
